# =============================================================================
# AniZora — Root environment template
# =============================================================================
# Copy to `.env` (docker compose reads this file automatically) and fill in.
#   cp .env.example .env
# NEVER commit the real `.env`.
# =============================================================================

# ----------------------------------------------------------------------------
# Branding (change these to rebrand the whole platform — no code edits needed)
# ----------------------------------------------------------------------------
SITE_NAME=AniZora
SITE_TAGLINE=Stream anime in stunning quality
SITE_URL=http://localhost:3000

# ----------------------------------------------------------------------------
# Ports exposed on the host
# ----------------------------------------------------------------------------
FRONTEND_PORT=3000
BACKEND_PORT=4000
POSTGRES_PORT=5432
REDIS_PORT=6379
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025
NGINX_HTTP_PORT=8080

# ----------------------------------------------------------------------------
# PostgreSQL
# ----------------------------------------------------------------------------
POSTGRES_USER=anizora
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=anizora
# Used by the backend container (host = the compose service name)
DATABASE_URL=postgresql://anizora:change_me_in_production@postgres:5432/anizora?schema=public
# Direct (non-pooled) connection, used ONLY by `prisma migrate deploy`.
# Locally this is the same database. On Supabase, DATABASE_URL is the
# transaction pooler (port 6543, add ?pgbouncer=true) and DIRECT_URL is the
# session connection (port 5432) — migrations cannot run through the pooler.
DIRECT_URL=postgresql://anizora:change_me_in_production@postgres:5432/anizora?schema=public

# ----------------------------------------------------------------------------
# Redis (caching + rate limiting + BullMQ). Optional: set REDIS_ENABLED=false
# to fall back to in-memory caching for local development.
# ----------------------------------------------------------------------------
REDIS_ENABLED=true
REDIS_URL=redis://redis:6379

# ----------------------------------------------------------------------------
# Backend core
# ----------------------------------------------------------------------------
NODE_ENV=development
BACKEND_PUBLIC_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000
API_PREFIX=api
SWAGGER_ENABLED=true

# ----------------------------------------------------------------------------
# Auth — GENERATE YOUR OWN SECRETS
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# ----------------------------------------------------------------------------
JWT_ACCESS_SECRET=replace_with_a_long_random_string
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# "Remember me" extends the refresh token lifetime to this value
JWT_REFRESH_TTL_REMEMBER=90d
BCRYPT_ROUNDS=12

# ----------------------------------------------------------------------------
# Seeded super-admin (created by `npm run db:seed`)
# ----------------------------------------------------------------------------
ADMIN_EMAIL=admin@anizora.local
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe123!

# ----------------------------------------------------------------------------
# Google OAuth (OPTIONAL — "Sign in with Google").
# Leave blank to disable the button entirely. Create your OWN credentials at
# https://console.cloud.google.com/apis/credentials
# ----------------------------------------------------------------------------
GOOGLE_OAUTH_ENABLED=false
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# ----------------------------------------------------------------------------
# Google Drive media provider
# ----------------------------------------------------------------------------
# Two supported, fully-documented auth modes:
#   service_account -> recommended. Share each Drive file/folder with the
#                      service-account email as Viewer.
#   oauth           -> uses a refresh token from your own OAuth client.
# See docs/GOOGLE_DRIVE.md for the exact step-by-step setup.
GOOGLE_DRIVE_ENABLED=false
GOOGLE_DRIVE_AUTH_MODE=service_account

# service_account mode: EITHER a path to the JSON key file mounted into the
# container, OR the whole JSON blob base64-encoded (handy for PaaS deploys).
GOOGLE_SERVICE_ACCOUNT_FILE=/run/secrets/google-service-account.json
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=

# oauth mode
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=

# Streaming proxy tuning
# Signed playback URLs prevent hot-linking of your Drive media.
MEDIA_SIGNING_SECRET=replace_with_another_long_random_string
MEDIA_SIGNED_URL_TTL=21600
# Max bytes served per range request (0 = unlimited, let the client decide)
MEDIA_MAX_RANGE_CHUNK=8388608

# ----------------------------------------------------------------------------
# Object storage (posters, banners, thumbnails, avatars, .vtt files)
#
#   local       — files on disk. Correct for Docker development, where the
#                 uploads volume persists. NEVER use this on a host with an
#                 ephemeral filesystem (Render free, Vercel, Fly): every deploy
#                 would silently delete all uploaded artwork.
#   cloudinary  — files on Cloudinary's CDN. Use this for hosted deployments.
#                 Needs the three CLOUDINARY_* values below.
#   s3          — placeholder only; the S3 driver is not implemented.
# ----------------------------------------------------------------------------
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=/app/storage/uploads
# Prefix written into stored image URLs. Keep it SITE-RELATIVE ("/uploads").
# An absolute http://localhost:4000/... value breaks images in Docker, because
# the Next.js image optimizer runs inside the frontend container where
# "localhost:4000" is not the API. The frontend serves /uploads/* by proxying
# to the API over the internal network. Use an absolute URL only when uploads
# are served from a real public host (a CDN or object storage).
STORAGE_PUBLIC_BASE_URL=/uploads
MAX_UPLOAD_SIZE_MB=15

# Cloudinary (only read when STORAGE_DRIVER=cloudinary).
# Sign up free at cloudinary.com; the dashboard shows all three. These are
# BACKEND-ONLY secrets — never expose them to the browser (no NEXT_PUBLIC_).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Uploads are grouped under this folder, so one account can host several sites.
CLOUDINARY_FOLDER=anizora

# S3-compatible (only read when STORAGE_DRIVER=s3)
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# ----------------------------------------------------------------------------
# Email / SMTP (password reset + email verification)
# Dev default targets MailHog in docker-compose (UI at http://localhost:8025).
# ----------------------------------------------------------------------------
MAIL_DRIVER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM_NAME=AniZora
MAIL_FROM_ADDRESS=no-reply@anizora.local

# ----------------------------------------------------------------------------
# Rate limiting
# ----------------------------------------------------------------------------
THROTTLE_TTL=60
THROTTLE_LIMIT=120
AUTH_THROTTLE_LIMIT=8

# ----------------------------------------------------------------------------
# Frontend (NEXT_PUBLIC_* values are inlined into the browser bundle —
# never put a secret here)
# ----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_NAME=AniZora
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Browser -> backend. Inside docker compose the SSR container uses
# INTERNAL_API_URL instead (service-to-service).
NEXT_PUBLIC_API_URL=http://localhost:4000/api
INTERNAL_API_URL=http://backend:4000/api

# ----------------------------------------------------------------------------
# Google AdSense — display ads (OPTIONAL)
# Get your publisher ID from https://adsense.google.com (looks like ca-pub-…).
# Leave blank: every display slot renders a labelled dev placeholder instead.
# ----------------------------------------------------------------------------
NEXT_PUBLIC_ADS_ENABLED=false
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
# Individual slot IDs are managed in the admin panel (Ads -> Placements),
# these are only the bootstrap defaults used by the seeder.
NEXT_PUBLIC_ADSENSE_TEST_MODE=true

# ----------------------------------------------------------------------------
# Google IMA — in-stream video ads (OPTIONAL)
# Real pre/mid/post-roll inventory requires Google Ad Manager (AdSense alone
# does NOT grant in-stream video ads). See docs/ADS.md.
# During development leave the sample tag; NEVER ship it to production.
# ----------------------------------------------------------------------------
NEXT_PUBLIC_VIDEO_ADS_ENABLED=false
NEXT_PUBLIC_IMA_VAST_TAG_URL=

# ----------------------------------------------------------------------------
# Adsterra — popunder (OPTIONAL)
# The popunder format shows NOTHING on the page: no banner, no widget. On a
# qualifying click the advert opens in its own window and AniZora stays open.
#
# In the Adsterra dashboard: Websites -> add your domain -> create a "Popunder"
# ad unit -> copy the invoke script URL out of the snippet it gives you. The
# snippet looks like <script src="//<your-subdomain>/<id>/invoke.js"></script>;
# paste ONLY that src value below (keep the leading //).
#
# Never armed on /admin/* or /auth/*, never for moderator/admin accounts, and
# at most once per FREQUENCY_HOURS per browser.
# These are build-time values: after changing them run
#   docker compose up -d --build frontend
# ----------------------------------------------------------------------------
NEXT_PUBLIC_ADSTERRA_ENABLED=false
NEXT_PUBLIC_ADSTERRA_POPUNDER_SRC=
NEXT_PUBLIC_ADSTERRA_FREQUENCY_HOURS=12

# Shared secret between the Next.js server and the API (see .env.example).
INTERNAL_API_TOKEN=
