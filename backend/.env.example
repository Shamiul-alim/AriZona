# =============================================================================
# Backend environment — copy to `.env` for running OUTSIDE Docker.
# When running via docker compose, values come from the ROOT .env instead.
# =============================================================================

NODE_ENV=development
PORT=4000
API_PREFIX=api
SWAGGER_ENABLED=true
BACKEND_PUBLIC_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000

SITE_NAME=AniZora
SITE_URL=http://localhost:3000

# Host-side database URL (note: localhost, not the compose service name)
DATABASE_URL=postgresql://anizora:anizora@localhost:5432/anizora?schema=public
# Direct (non-pooled) connection, used ONLY by `prisma migrate deploy`.
# On Supabase this is the session connection on port 5432, while
# DATABASE_URL is the transaction pooler on 6543 (?pgbouncer=true).
DIRECT_URL=postgresql://anizora:anizora@localhost:5432/anizora?schema=public

REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379

# GENERATE YOUR OWN:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=dev_only_access_secret_replace_me
JWT_REFRESH_SECRET=dev_only_refresh_secret_replace_me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
JWT_REFRESH_TTL_REMEMBER=90d
BCRYPT_ROUNDS=10

ADMIN_EMAIL=admin@anizora.local
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe123!

GOOGLE_OAUTH_ENABLED=false
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

GOOGLE_DRIVE_ENABLED=false
GOOGLE_DRIVE_AUTH_MODE=service_account
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=

MEDIA_SIGNING_SECRET=dev_only_media_signing_secret_replace_me
MEDIA_SIGNED_URL_TTL=21600
MEDIA_MAX_RANGE_CHUNK=8388608

# local for Docker development, cloudinary for hosted deployments.
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage/uploads
STORAGE_PUBLIC_BASE_URL=/uploads
MAX_UPLOAD_SIZE_MB=15

# Cloudinary (only read when STORAGE_DRIVER=cloudinary). Backend-only secrets.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=anizora

S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# `log` prints the email to the console instead of sending it — the default for
# local development so no SMTP account is needed.
MAIL_DRIVER=log
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM_NAME=AniZora
MAIL_FROM_ADDRESS=no-reply@anizora.local

THROTTLE_TTL=60
THROTTLE_LIMIT=120
AUTH_THROTTLE_LIMIT=8
