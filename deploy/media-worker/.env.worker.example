# =============================================================================
# AniZora media worker — configuration
# =============================================================================
# Copy this to `.env.worker` and fill it in. The installer does that for you;
# this file is here for anyone who would rather edit it by hand.
#
# `.env.worker` holds live credentials. Do not commit it, email it, paste it
# into chat, or put it in a shared folder.
# =============================================================================

# --- The AniZora API ---------------------------------------------------------
# Where this worker asks for jobs. Include the /api suffix.
API_URL=https://arizona-3.onrender.com/api

# The shared secret that lets this worker claim jobs. It must match
# MEDIA_WORKER_TOKEN in the Render backend environment exactly.
#
# It authorises five endpoints and nothing else: list jobs, claim, report
# progress, register output, finish. It cannot read users or edit the
# catalogue.
#
# Generate one with:   openssl rand -base64 32
MEDIA_WORKER_TOKEN=

# --- Google Drive ------------------------------------------------------------
# Reading masters: a service account, supplied as base64 so it fits in an
# environment variable rather than needing a file path on this machine.
#
#   Windows:  [Convert]::ToBase64String([IO.File]::ReadAllBytes("key.json"))
#   Linux:    base64 -w0 key.json
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=

# Writing generated media: an OAuth client. A service account has no Drive
# storage quota of its own, so anything it created would have nowhere to live.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=

# --- Optional ----------------------------------------------------------------
# Defaults below are what the worker uses when these are left unset.

# Seconds between checks for new work.
# POLL_SECONDS=30

# Refuse a job below this much free scratch space (bytes). 12 GB by default.
# MIN_FREE_DISK_BYTES=12884901888

# Ceiling for generated media kept in Drive (bytes). Oldest is evicted first;
# masters are never touched. 8 GB by default.
# MAX_CACHE_BYTES=8589934592

# Encoder speed against file size. Slower presets make smaller files.
# FFMPEG_PRESET=veryfast
# FFMPEG_CRF=23

# Drive folder for generated media.
# RENDITION_FOLDER=AniZora _renditions

# Host resources this container may use.
# WORKER_CPUS=2
# WORKER_MEMORY=4G

# Where the image is built from. Pin a tag or commit for a fixed version.
# WORKER_SOURCE=https://github.com/Shamiul-alim/AriZona.git#main:backend
